{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "TravelPlanner.Api",
    "Audience": "TravelPlanner.Web"
  },
  "Wikimedia": {
    "UserAgent": "TravelPlannerBiH/1.0 (https://github.com/tarik/travel-planner-bih)",
    "TimeoutSeconds": 10,
    "RequestsPerSecond": 2
  },
  "Wikidata": {
    "BaseUrl": "https://www.wikidata.org/",
    "ClassTypeMappings": {
      "Q515": "grad",
      "Q8502": "planina",
      "Q532": "selo",
      "Q23397": "jezero",
      "Q4022": "rijeka"
    },
    "RegionEntityIds": [ "Q230", "Q194483" ]
  },
  "Wikipedia": {
    "ApiUrlTemplate": "https://{0}.wikipedia.org/api/rest_v1/",
    "MinimumSummaryLength": 120
  },
  "WikimediaCommons": {
    "BaseUrl": "https://commons.wikimedia.org/"
  },
  "Mapbox": {
    "BaseUrl": "https://api.mapbox.com/",
    "TimeoutSeconds": 10
  },
  "DestinationImport": {
    "TtlHours": 168,
    "DefaultBudgetTier": "standard",
    "DefaultSuggestedStayMinDays": 1,
    "DefaultSuggestedStayMaxDays": 3,
    "DefaultBestTimeToVisit": "proljeće-jesen",
    "DefaultBestSeasons": [ "spring", "summer", "autumn" ],
    "RequireCoordinatesForRecommendation": true,
    "RequireBosnianDescriptionForRecommendation": true,
    "TagsByType": {
      "grad": [ "grad", "kultura" ],
      "planina": [ "planina", "priroda", "avantura" ],
      "selo": [ "selo", "kultura", "priroda" ],
      "jezero": [ "jezero", "priroda" ],
      "rijeka": [ "rijeka", "priroda" ],
      "ostalo": [ "priroda" ]
    }
  },
  "RateLimiting": {
    "DestinationImportPermitLimit": 5,
    "DestinationImportWindowSeconds": 60,
    "DestinationSearchPermitLimit": 20,
    "DestinationSearchWindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
